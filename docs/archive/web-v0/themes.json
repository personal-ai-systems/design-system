      { "theme": "light", "foreground": "on-surface-muted", "background": "surface-container", "min": 4.5 },
      { "theme": "light", "foreground": "on-error", "background": "error", "min": 4.5 },
      { "theme": "light", "foreground": "focus", "background": "surface", "min": 3 },
      { "theme": "light", "foreground": "outline", "background": "surface", "min": 3 },
      { "theme": "dark", "foreground": "on-primary", "background": "primary", "min": 4.5 },
      { "theme": "dark", "foreground": "on-primary-container", "background": "primary-container", "min": 4.5 },
      { "theme": "dark", "foreground": "on-secondary", "background": "secondary", "min": 4.5 },
