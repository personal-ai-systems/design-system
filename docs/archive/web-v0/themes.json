        "tertiary": "{color.deep.60}",
        "on-tertiary": "{color.deep.20}",
        "surface": "{color.neutral.92}",
        "on-surface": "{color.neutral.10}",
        "surface-container": "{color.neutral.96}",
        "on-surface-muted": "{color.quiet.60}",
        "outline": "{color.quiet.40}",
        "error": "{color.alert.80}",
        "on-error": "{color.alert.10}",
        "focus": "{color.accent.60}"
      }
    }
  },
  "contrast": {
    "note": "Minimum ratios this system claims. Text pairs are measured against the WCAG 2.1 AA thresholds; the outline pair is a non-text boundary and is only held to 3:1.",
    "pairs": [
      { "theme": "light", "foreground": "on-primary", "background": "primary", "min": 4.5 },
      { "theme": "light", "foreground": "on-primary-container", "background": "primary-container", "min": 4.5 },
      { "theme": "light", "foreground": "on-secondary", "background": "secondary", "min": 4.5 },
      { "theme": "light", "foreground": "on-tertiary", "background": "tertiary", "min": 4.5 },
      { "theme": "light", "foreground": "on-surface", "background": "surface", "min": 4.5 },
