{
  "meta": {
    "name": "Personal AI Systems themes",
    "namespace": "pas",
    "version": "0.1.0",
    "status": "provisional",
    "note": "Each theme maps every public color role to a reference value. Replacing a palette means editing only this file and re-running scripts/build-tokens.mjs; components and pages reference roles and must not be edited."
  },
  "themes": {
    "light": {
      "label": "Light",
      "color": {
        "primary": "{color.accent.30}",
        "on-primary": "{color.neutral.0}",
        "primary-container": "{color.accent.80}",
        "on-primary-container": "{color.accent.10}",
        "secondary": "{color.cool.30}",
        "on-secondary": "{color.neutral.0}",
        "tertiary": "{color.deep.30}",
        "on-tertiary": "{color.neutral.0}",
        "surface": "{color.neutral.4}",
        "on-surface": "{color.neutral.85}",
        "surface-container": "{color.neutral.10}",
        "on-surface-muted": "{color.neutral.55}",
        "outline": "{color.neutral.40}",
        "error": "{color.alert.30}",
        "on-error": "{color.neutral.0}",
        "focus": "{color.accent.30}"
      }
    },
    "dark": {
      "label": "Dark",
      "color": {
        "primary": "{color.accent.60}",
        "on-primary": "{color.accent.10}",
        "primary-container": "{color.accent.20}",
        "on-primary-container": "{color.accent.80}",
        "secondary": "{color.cool.70}",
